<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PackageDetailsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@color/primary_blue"
        app:titleTextAppearance="@style/CustomActionBarTitle"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/white"
        app:navigationIconTint="@color/white" />

    <TextView
        android:id="@+id/carrierTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:background="@color/carrier_banner_background"
        android:gravity="center"
        android:padding="4dp"
        android:text="@string/carrier"
        android:textAllCaps="true"
        android:textColor="@color/carrier_banner_text"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/completedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/mark_as_completed"
        android:textAllCaps="false"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/completedButton"
        android:layout_below="@id/carrierTv">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trackingDetailsRv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            app:layoutManager="LinearLayoutManager" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/empty_details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/completedButton"
        android:layout_below="@id/carrierTv"
        android:gravity="center"
        android:text="@string/no_status_information"
        android:textSize="18sp"
        android:visibility="gone" />

</RelativeLayout>